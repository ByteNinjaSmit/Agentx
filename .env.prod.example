# Copy to .env on the VPS (never commit the real one — .gitignore already covers .env)
POSTGRES_PASSWORD=changeme
N8N_USER=admin
N8N_PASSWORD=changeme
VPS_IP=your.vps.ip
N8N_DOMAIN=your.n8n.domain
# CI keeps this in sync from the GEMINI_API_KEY GitHub secret on every deploy —
# still has to be pasted into n8n's Google Gemini credential via the n8n UI once,
# community-edition n8n doesn't read container env vars into stored credentials.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_PROVIDER=gemini
S2_API_KEY=
GITHUB_TOKEN=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Optional — high-impact (score >= 8) alerts from the Python backend.
SLACK_WEBHOOK_URL=
