# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Embeddings used for semantic relevance scoring and stored in pgvector.
# GEMINI_EMBED_DIM must match the vector(N) width in db/schema.sql.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Anthropic (optional second provider — the backend runs on whichever provider
# a run selects; AGENT_PROVIDER sets the default when the request doesn't say).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — thinking depth and token spend
ANTHROPIC_EFFORT=high
AGENT_PROVIDER=gemini

# Specialist fleet (pipeline=fleet). More sub-questions means wider coverage and
# proportionally more model calls.
FLEET_MAX_SUBQUESTIONS=4
FLEET_RESEARCH_STEPS=4

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://compintel:devpass@localhost:5433/compintel

# Optional — Semantic Scholar (eliminates 429 rate limits on research search)
S2_API_KEY=

# Optional — news
NEWSAPI_KEY=

# Optional — GitHub (works unauthenticated at 60 req/hr; a token raises it to 5000/hr)
GITHUB_TOKEN=

# Optional — USPTO Open Data Portal (live patent search; requires a free
# USPTO.gov account with MFA — request a key at https://data.uspto.gov/apis).
# Unset: search_patents uses the curated fixture at backend/fixtures/patents.json,
# same as before this was added. A live-call failure also falls back to it.
USPTO_ODP_API_KEY=

# Optional — Google Programmable Search (web search source). Both required together.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional — alerts
SLACK_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
