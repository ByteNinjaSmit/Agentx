# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Embeddings used for semantic relevance scoring and stored in pgvector.
# GEMINI_EMBED_DIM must match the vector(N) width in db/schema.sql.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Anthropic (optional second provider — the backend runs on whichever provider
# a run selects; AGENT_PROVIDER sets the default when the request doesn't say).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — thinking depth and token spend
ANTHROPIC_EFFORT=high
AGENT_PROVIDER=gemini

# Specialist fleet (pipeline=fleet). More sub-questions means wider coverage and
# proportionally more model calls.
FLEET_MAX_SUBQUESTIONS=4
FLEET_RESEARCH_STEPS=4

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://compintel:devpass@localhost:5433/compintel

# Optional — Semantic Scholar (eliminates 429 rate limits on research search)
S2_API_KEY=

# Optional — news
NEWSAPI_KEY=

# Optional — GitHub (works unauthenticated at 60 req/hr; a token raises it to 5000/hr)
GITHUB_TOKEN=

# Optional — Google Programmable Search (web search source; both required
# together). NOTE: as of when this was written, Google's Custom Search JSON API
# no longer grants access to *new* Cloud projects (returns 403 even with the API
# enabled and billing linked) — only useful here if you already have working
# access from an older project. For a NEW live patent source, use SERPAPI_API_KEY
# below instead.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional — SerpAPI (https://serpapi.com), the easy live patent source: email
# signup only, no identity verification, 250 free searches/month, includes a
# Google Patents engine. Recommended over both patent options below unless you
# already have one working.
SERPAPI_API_KEY=

# Optional — USPTO Open Data Portal (the most structured live patent search —
# assignee, filing/grant date — but requires a free USPTO.gov account with MFA
# identity verification: https://data.uspto.gov/apis). Skip this and use
# SERPAPI_API_KEY above if that verification is too much friction.
# All three unset, or all fail: search_patents uses the curated fixture at
# backend/fixtures/patents.json, same as before any live source was added.
USPTO_ODP_API_KEY=

# Optional — alerts
SLACK_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
